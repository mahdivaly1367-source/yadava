{
  "name": "navanegar",
  "private": true,
  "version": "1.0.0",
  "description": "نوانگار (Navanegar) — استودیوی جامع آموزش ردیف و موسیقی اصیل ایرانی",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/validate-firestore-rules.mjs",
    "lint:rules": "eslint firestore.rules && node scripts/validate-firestore-rules.mjs",
    "test": "vitest run --exclude src/rules/firestore.rules.test.ts",
    "test:watch": "vitest --exclude src/rules/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --project demo-navanegar-rules --only firestore \"npx vitest run src/rules/firestore.rules.test.ts\"",
    "cap:sync": "npm run build && npx cap sync android",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "android:bazaar:debug": "cd android && ./gradlew assembleBazaarDebug",
    "android:myket:debug": "cd android && ./gradlew assembleMyketDebug",
    "android:bazaar:release": "cd android && ./gradlew assembleBazaarRelease bundleBazaarRelease",
    "android:myket:release": "cd android && ./gradlew assembleMyketRelease bundleMyketRelease"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.2.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@fontsource/vazirmatn": "^5.2.5",
    "firebase": "^11.10.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@eslint/js": "^9.30.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
